<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <PackageId>Alma.JsonApi</PackageId>
    <Version>10.0.0</Version>
    <Authors>Almacareer</Authors>
    <Description>Json Api types and basic implementations.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/alma-oss/fjson-api.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alma-oss/fjson-api</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/Utils.fs" />
    <Compile Include="src/JsonApi.fs" />
    <Compile Include="src/Tracing.fs" />
    <Compile Include="src/Http.fs" />
  </ItemGroup>

  <Import Project=".paket\Paket.Restore.targets" />
</Project>
